# Secrets — ne jamais committer
.env
infra/.env
infra/traefik/letsencrypt/

# Backend
backend/node_modules/
backend/dist/

# Flutter
app/build/
app/.dart_tool/
app/**/generated_plugin_registrant.dart

# Général
.DS_Store
*.log
backend/generated/

# Flutter — artefacts de build et fichiers générés
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/*.iml
app/windows/flutter/ephemeral/
app/android/.gradle/
app/android/local.properties
# Code généré (freezed / json_serializable / drift) : régénéré par
# `dart run build_runner build`, comme le client Prisma côté backend.
app/lib/**/*.g.dart
app/lib/**/*.freezed.dart

# Signature Android de production — jamais dans Git (perdu = plus aucune mise à jour possible)
app/android/key.properties
*.jks
*.keystore
