# ─────────────────────────────────────────────────────────
# Compte ADMIN de MinIO — à copier en `.env.minio-root` sur le VPS.
# Chargé UNIQUEMENT par les services `minio` et `minio-init`, jamais par le
# backend : celui-ci n'utilise que le compte de service limité au bucket.
# ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=CHANGER_CET_ADMIN
MINIO_ROOT_PASSWORD=CHANGER_CE_MOT_DE_PASSE
