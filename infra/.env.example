# ─────────────────────────────────────────────────────────
# Copier ce fichier en `.env` sur le VPS (jamais commité dans Git)
# ─────────────────────────────────────────────────────────

# Domaines — à pointer vers l'IP du VPS via DNS (enregistrement A)
API_DOMAIN=api.tondomaine.com
STORAGE_DOMAIN=storage.tondomaine.com

# Email utilisé par Let's Encrypt pour les notifs de certificat
ACME_EMAIL=toi@example.com

# PostgreSQL
POSTGRES_USER=magasin_prod
POSTGRES_PASSWORD=CHANGER_CE_MOT_DE_PASSE
POSTGRES_DB=gestion_magasin
# Utilisé par le backend NestJS/Prisma pour se connecter (nom du service Docker "postgres")
DATABASE_URL=postgresql://magasin_prod:CHANGER_CE_MOT_DE_PASSE@postgres:5432/gestion_magasin

# Redis
REDIS_PASSWORD=CHANGER_CE_MOT_DE_PASSE
REDIS_URL=redis://:CHANGER_CE_MOT_DE_PASSE@redis:6379

# MinIO (stockage fichiers/images)
MINIO_ACCESS_KEY=CHANGER_CETTE_CLE
MINIO_SECRET_KEY=CHANGER_CE_SECRET
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=produits

# Identité imprimée sur les tickets et factures PDF (vide = ligne omise).
# Mentions légales de la facture : à renseigner avant la mise en service.
STORE_NAME=
STORE_ADDRESS=
STORE_PHONE=
STORE_NIF=
STORE_RC=
STORE_NIS=
STORE_AI=

# JWT — générer une chaîne aléatoire longue (ex: openssl rand -base64 48)
# Le refresh token est OPAQUE (pas un JWT) : stocké hashé en table `RefreshToken`,
# révocable, 90 jours glissants (spec-fonctionnelle §2bis). Il n'a donc pas de secret.
# ⚠ Le backend REFUSE DE DÉMARRER avec cette valeur d'exemple ou une clé < 32 octets.
JWT_ACCESS_SECRET=CHANGER_CETTE_CLE_ALEATOIRE
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_DAYS=90

# Reverse-proxy : nombre de sauts de confiance devant le backend. En prod,
# Traefik est le SEUL proxy → 1. Sans cela, tous les clients partagent le même
# compteur anti-brute-force et l'audit enregistre l'IP de Traefik.
# Ne jamais mettre plus que le nombre réel de proxys (X-Forwarded-For forgeable).
TRUST_PROXY_HOPS=1

# Anti-brute-force (par IP réelle, fenêtre 15 min) — défauts sûrs si absents.
# AUTH_LOGIN_LIMIT=10
# AUTH_REFRESH_LIMIT=30
# AUTH_CHANGE_PASSWORD_LIMIT=5
# Limite globale par IP et par minute :
# API_RATE_LIMIT=120

# Admin initial créé par le seed. Laisser vide en prod pour ne créer aucun compte
# automatiquement (créer l'admin manuellement, puis retirer ces variables).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrateur

# Général
NODE_ENV=production
PORT=3000
