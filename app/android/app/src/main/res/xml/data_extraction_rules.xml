<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ ignore `allowBackup` pour le TRANSFERT D'APPAREIL : sans ces règles,
  la base locale (file de mutations, données métier) serait copiée vers un
  nouveau téléphone. Tout est exclu, en sauvegarde cloud comme en transfert.
  Contre-audit N9.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
