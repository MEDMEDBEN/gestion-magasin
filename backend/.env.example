# ─────────────────────────────────────────────────────────
# Développement local — copier en `backend/.env` (jamais commité)
# Prérequis : `cd infra && docker compose -f docker-compose.dev.yml up -d`
# ─────────────────────────────────────────────────────────

# Lu par la CLI Prisma (via prisma7.config.ts) ET par PrismaService au runtime.
DATABASE_URL="postgresql://dev:dev@localhost:5432/gestion_magasin_dev?schema=public"

# JWT — générer une valeur aléatoire : openssl rand -base64 48
# Le backend REFUSE DE DÉMARRER avec la valeur d'exemple ou une clé < 32 octets.
JWT_ACCESS_SECRET=CHANGER_CETTE_CLE_ALEATOIRE
JWT_ACCESS_EXPIRES_SECONDS=900
# Refresh token opaque (pas un JWT), stocké hashé en table, 90 j glissants — spec §2bis.
JWT_REFRESH_EXPIRES_DAYS=90

# Admin initial créé par `npm run seed`.
# Sans ces variables, le seed ne crée AUCUN compte (comportement voulu en prod).
SEED_ADMIN_EMAIL=admin@magasin.dz
SEED_ADMIN_PASSWORD=ChangeMoi123!
SEED_ADMIN_NAME=Administrateur

PORT=3000

# Pas de reverse-proxy en dev : 0 (défaut). En prod derrière Traefik : 1.
TRUST_PROXY_HOPS=0

# MinIO (photos produits). En dev : valeurs de infra/docker-compose.dev.yml.
# Le backend REFUSE DE DÉMARRER si une variable manque ou vaut CHANGER_*.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=devaccess
MINIO_SECRET_KEY=devsecret123
MINIO_BUCKET=produits

# Identité imprimée sur les tickets et factures PDF (vide = ligne omise)
STORE_NAME=Magasin de matériel électrique
STORE_ADDRESS=
STORE_PHONE=
STORE_NIF=
STORE_RC=
STORE_NIS=
STORE_AI=
